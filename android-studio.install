post_upgrade() {
  # $1: new version, $2: old version.
  # Cache directories are named after the series, the first two version
  # components. Example: 2026.1.3.8 uses ~/.cache/Google/AndroidStudio2026.1.
  _old_rest=${2#*.}
  _new_rest=${1#*.}
  _old_series="${2%%.*}.${_old_rest%%.*}"
  _new_series="${1%%.*}.${_new_rest%%.*}"

  # A version in the same series reuses the same cache directory.
  if [ "$_old_series" = "$_new_series" ]; then
    return 0
  fi

  for _cache in /home/*/.cache/Google/AndroidStudio"$_old_series"; do
    if [ -d "$_cache" ]; then
      echo "Removing cache of previous Android Studio $_old_series: $_cache"
      rm -rf "$_cache"
    fi
  done
}
